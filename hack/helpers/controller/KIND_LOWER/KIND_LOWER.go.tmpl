const (
	// errTrackPCUsage is used when tracking the ProviderConfig usage fails.
	errTrackPCUsage = "cannot track ProviderConfig usage"
	// errGetPC is used when getting the ProviderConfig fails.
	errGetPC = "cannot get ProviderConfig"
	// errNewClient is used when creating a new Nexus client fails.
	errNewClient = "cannot create new Nexus client"
	// errGet{{ .Env.KIND }} is used when getting the {{ .Env.KIND }} from Nexus fails.
	errGet{{ .Env.KIND }} = "cannot get {{ .Env.KIND }} from Nexus"
	// errCreate{{ .Env.KIND }} is used when creating the {{ .Env.KIND }} in Nexus fails.
	errCreate{{ .Env.KIND }} = "cannot create {{ .Env.KIND }} in Nexus"
	// errUpdate{{ .Env.KIND }} is used when updating the {{ .Env.KIND }} in Nexus fails.
	errUpdate{{ .Env.KIND }} = "cannot update {{ .Env.KIND }} in Nexus"
	// errDelete{{ .Env.KIND }} is used when deleting the {{ .Env.KIND }} from Nexus fails.
	errDelete{{ .Env.KIND }} = "cannot delete {{ .Env.KIND }} from Nexus"
)

// Setup adds a controller that reconciles {{ .Env.KIND }} managed resources.
// Register it, with {{ .Env.GROUP | strings.ToLower }}{{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }}GroupVersionKind, in the
// managedControllers list of internal/controller/register.go, which also
// gates it behind its CustomResourceDefinition when safe-start is enabled.
func Setup(mgr ctrl.Manager, opts helpers.Options) error {
	name := managed.ControllerName({{ .Env.GROUP | strings.ToLower }}{{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }}GroupKind)

	// helpers.ReconcilerOptions adds the options every controller shares:
	// logger, poll interval and its minimum, event recorder, management
	// policies, change logs and metrics. Only pass the options specific to
	// this controller.
	reconcilerOpts := helpers.ReconcilerOptions(mgr, name, opts,
		managed.WithTypedExternalConnector[*{{ .Env.GROUP | strings.ToLower }}{{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }}](&connector{
			kube:  mgr.GetClient(),
			usage: resource.NewProviderConfigUsageTracker(mgr.GetClient(), &nexusv1alpha1.ProviderConfigUsage{}),
		}),
		// TODO: Return the spec field that names the {{ .Env.KIND }} in Nexus. Use
		// helpers.WithServerAssignedExternalName() instead if Nexus assigns
		// the identifier on creation.
		helpers.WithSpecExternalName(mgr.GetClient(), func(cr *{{ .Env.GROUP | strings.ToLower }}{{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }}) string {
			return cr.Spec.ForProvider.ConfigurableField
		}),
	)

	reconciler := managed.NewReconciler(mgr, resource.ManagedKind({{ .Env.GROUP | strings.ToLower }}{{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }}GroupVersionKind), reconcilerOpts...)

	err := helpers.AddMRStateRecorder(mgr, opts, &{{ .Env.GROUP | strings.ToLower }}{{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }}List{})
	if err != nil {
		return err
	}

	return ctrl.NewControllerManagedBy(mgr).
		Named(name).
		WithOptions(opts.ForControllerRuntime()).
		WithEventFilter(resource.DesiredStateChanged()).
		For(&{{ .Env.GROUP | strings.ToLower }}{{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }}{}).
		Complete(ratelimiter.NewReconciler(name, reconciler, opts.GlobalRateLimiter))
}

// connector implements managed.TypedExternalConnector.
type connector struct {
	kube  client.Client
	usage *resource.ProviderConfigUsageTracker
}

// Connect produces a TypedExternalClient for the given managed resource.
func (c *connector) Connect(ctx context.Context, {{ .Env.KIND | strings.ToLower }} *{{ .Env.GROUP | strings.ToLower }}{{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }}) (managed.TypedExternalClient[*{{ .Env.GROUP | strings.ToLower }}{{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }}], error) {
	err := c.usage.Track(ctx, {{ .Env.KIND | strings.ToLower }})
	if err != nil {
		return nil, errors.Wrap(err, errTrackPCUsage)
	}

	creds, err := nexus.GetCredentials(ctx, c.kube, {{ .Env.KIND | strings.ToLower }})
	if err != nil {
		return nil, errors.Wrap(err, errGetPC)
	}

	nexusClient, err := {{ .Env.GROUP | strings.ToLower }}client.New{{ .Env.KIND }}Client(creds)
	if err != nil {
		return nil, errors.Wrap(err, errNewClient)
	}

	return &external{client: nexusClient}, nil
}

